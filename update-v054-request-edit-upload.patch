+/* MSM request editing + inline upload progress v0.5.4 */
+
+.invoiceRequestSellerSummary {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 12px;
+  padding: 12px;
+  border: 1px solid #e7e5e4;
+  border-radius: 14px;
+  background: #fafaf9;
+}
+
+.invoiceRequestSellerSummary span,
+.invoiceRequestSellerSummary strong {
+  display: block;
+}
+
+.invoiceRequestSellerSummary span {
+  color: #78716c;
+  font-size: 11px;
+}
+
+.invoiceRequestSellerSummary strong {
+  margin-top: 2px;
+  font-size: 17px;
+}
+
+.invoiceRequestEditWarning {
+  padding: 9px 10px;
+  border-radius: 11px;
+  background: #fffbeb;
+  color: #92400e;
+  font-size: 11px;
+  line-height: 1.45;
+}
+
+.invoiceRequestWithdrawnHead > b {
+  background: #e7e5e4;
+  color: #57534e;
+}
+
+.invoiceRequestUploadState,
+.dealUploadState {
+  display: grid;
+  gap: 7px;
+  padding: 11px 12px;
+  border: 1px solid #bfdbfe;
+  border-radius: 13px;
+  background: #eff6ff;
+}
+
+.invoiceRequestUploadTop,
+.dealUploadStateTop {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 10px;
+}
+
+.invoiceRequestUploadTop strong,
+.dealUploadStateTop strong {
+  min-width: 0;
+  font-size: 12px;
+}
+
+.invoiceRequestUploadTop b,
+.dealUploadStateTop b {
+  flex: 0 0 auto;
+  color: #2563eb;
+  font-size: 11px;
+}
+
+.invoiceRequestUploadState > span,
+.dealUploadState > span {
+  color: #64748b;
+  font-size: 10px;
+  overflow-wrap: anywhere;
+}
+
+.invoiceRequestUploadBar,
+.dealUploadMiniBar {
+  height: 6px;
+  overflow: hidden;
+  border-radius: 999px;
+  background: #dbeafe;
+}
+
+.invoiceRequestUploadBar > span,
+.dealUploadMiniBar > span {
+  display: block;
+  height: 100%;
+  border-radius: inherit;
+  background: #3b82f6;
+  transition: width 180ms ease;
+}
+
+.dealUploadState {
+  margin-top: 10px;
+  text-align: left;
+}
+
+.invoiceRequestUpload-success,
+.dealUpload-success {
+  border-color: #bbf7d0;
+  background: #f0fdf4;
+}
+
+.invoiceRequestUpload-success .invoiceRequestUploadBar > span,
+.dealUpload-success .dealUploadMiniBar > span {
+  background: #22c55e;
+}
+
+.invoiceRequestUpload-success .invoiceRequestUploadTop b,
+.dealUpload-success .dealUploadStateTop b {
+  color: #15803d;
+}
+
+.invoiceRequestUpload-error,
+.dealUpload-error {
+  border-color: #fecaca;
+  background: #fef2f2;
+}
+
+.invoiceRequestUpload-error .invoiceRequestUploadBar > span,
+.dealUpload-error .dealUploadMiniBar > span {
+  background: #ef4444;
+}
+
+.invoiceRequestUpload-error .invoiceRequestUploadTop b,
+.dealUpload-error .dealUploadStateTop b {
+  color: #b91c1c;
+}
+
+html[data-theme='dark'] .invoiceRequestSellerSummary,
+html[data-theme='dark'] .invoiceRequestUploadState,
+html[data-theme='dark'] .dealUploadState {
+  background: #242426;
+  border-color: #343437;
+}
+
+html[data-theme='dark'] .invoiceRequestSellerSummary span,
+html[data-theme='dark'] .invoiceRequestUploadState > span,
+html[data-theme='dark'] .dealUploadState > span {
+  color: #a8a29e;
+}
+
+html[data-theme='dark'] .invoiceRequestEditWarning {
+  background: #292317;
+  color: #fcd34d;
+}
+
+html[data-theme='dark'] .invoiceRequestUploadBar,
