+
+.dealIncomingInvoiceHead {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 12px;
+}
+
+.dealIncomingInvoiceHead > div:first-child {
+  min-width: 0;
+}
+
+.dealIncomingInvoiceHead span,
+.dealIncomingInvoiceHead strong {
+  display: block;
+}
+
+.dealIncomingInvoiceHead span {
+  color: #78716c;
+  font-size: 10px;
+}
+
+.dealIncomingInvoiceHead strong {
+  margin-top: 3px;
+  overflow-wrap: anywhere;
+  font-size: 13px;
+}
+
+.dealIncomingInvoiceActions {
+  display: flex;
+  align-items: center;
+  justify-content: flex-end;
+  gap: 7px;
+  flex-shrink: 0;
+}
+
+.dealIncomingInvoiceActions > a,
+.dealIncomingInvoiceHistoryRow > a {
+  color: #171717;
+  font-size: 11px;
+  font-weight: 800;
+}
+
+.dealIncomingInvoiceHistory {
+  display: grid;
+  gap: 6px;
+  padding-top: 8px;
+  border-top: 1px solid #f0efed;
+}
+
+.dealIncomingInvoiceHistoryRow {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 10px;
+  padding: 8px 9px;
+  border-radius: 10px;
+  background: #fafaf9;
+}
+
+.dealIncomingInvoiceHistoryRow > div {
+  min-width: 0;
+}
+
+.dealIncomingInvoiceHistoryRow b,
+.dealIncomingInvoiceHistoryRow span {
+  display: block;
+  overflow-wrap: anywhere;
+}
+
+.dealIncomingInvoiceHistoryRow b {
+  font-size: 11px;
+}
+
+.dealIncomingInvoiceHistoryRow span {
+  margin-top: 2px;
+  color: #a8a29e;
+  font-size: 9px;
+}
+
+.purchaseSelectedInvoice {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 10px;
+  padding: 10px;
+  border: 1px solid #e7e5e4;
+  border-radius: 12px;
+  background: #fafaf9;
+}
+
+.purchaseSelectedInvoice > div {
+  min-width: 0;
+}
+
+.purchaseSelectedInvoice b,
+.purchaseSelectedInvoice span {
+  display: block;
+  overflow-wrap: anywhere;
+}
+
+.purchaseSelectedInvoice b {
+  font-size: 12px;
+}
+
+.purchaseSelectedInvoice span {
+  margin-top: 2px;
+  color: #78716c;
+  font-size: 10px;
+}
+
+.purchaseSelectedInvoice > a {
+  flex-shrink: 0;
+  color: #171717;
+  font-size: 11px;
+  font-weight: 800;
+}
+
+.purchaseInvoiceCurrent {
+  display: grid;
+  gap: 7px;
+}
+
+.purchaseInvoiceCurrentHead {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 10px;
+}
+
+.purchaseInvoiceCurrentHead > span {
+  color: #78716c;
+  font-size: 10px;
+  font-weight: 700;
+}
+
+.purchaseInvoiceEditButton {
+  border: 0;
+  background: transparent;
+  color: #57534e;
+  padding: 2px 0;
+  font-size: 11px;
+  font-weight: 800;
+}
+
+.purchaseInvoiceMissing {
+  padding: 10px;
+  border: 1px dashed #d6d3d1;
+  border-radius: 11px;
+  color: #78716c;
+  font-size: 11px;
+  text-align: center;
+}
+
+.purchaseInvoiceEditor {
+  display: grid;
+  gap: 10px;
+  padding: 11px;
+  border: 1px solid #e7e5e4;
+  border-radius: 13px;
+  background: #fff;
+  animation: msmFadeUp 160ms ease-out both;
+}
+
+.purchaseInvoiceWarning {
+  padding: 9px 10px;
+  border: 1px solid #fde68a;
+  border-radius: 10px;
+  background: #fffbeb;
+  color: #92400e;
+  font-size: 10px;
+  line-height: 1.4;
+}
+
+.purchaseInvoiceEditorActions {
+  display: grid;
+  grid-template-columns: 1fr 1.4fr;
+  gap: 8px;
+}
+
+html[data-theme='dark'] .dealOverviewInvoiceStatus,
+html[data-theme='dark'] .dealIncomingInvoiceCard,
+html[data-theme='dark'] .purchaseInvoiceEditor {
+  background: #1d1d1f;
+  border-color: #343437;
+}
+
+html[data-theme='dark'] .dealInvoiceStatus-working {
+  background: #172238;
+  border-color: #1d4ed8;
+}
+
+html[data-theme='dark'] .dealInvoiceStatus-review {
+  background: #292317;
+  border-color: #854d0e;
+}
+
+html[data-theme='dark'] .dealInvoiceStatus-customer {
+  background: #221c34;
+  border-color: #6d28d9;
+}
+
+html[data-theme='dark'] .dealInvoiceStatus-correction,
+html[data-theme='dark'] .dealInvoiceStatus-needs-data {
+  background: #2d2118;
+  border-color: #9a3412;
+}
+
+html[data-theme='dark'] .dealInvoiceStatus-agreed {
+  background: #16281d;
+  border-color: #166534;
+}
+
+html[data-theme='dark'] .supplierBadge {
+  background: #303033;
+}
+
+html[data-theme='dark'] .dealIncomingInvoiceHistory {
+  border-color: #303033;
+}
+
+html[data-theme='dark'] .dealIncomingInvoiceHistoryRow,
+html[data-theme='dark'] .purchaseSelectedInvoice {
+  background: #242426;
+  border-color: #343437;
+}
+
+html[data-theme='dark'] .dealIncomingInvoiceActions > a,
+html[data-theme='dark'] .dealIncomingInvoiceHistoryRow > a,
+html[data-theme='dark'] .purchaseSelectedInvoice > a {
+  color: #f5f5f4;
+}
+
+html[data-theme='dark'] .purchaseInvoiceMissing {
+  border-color: #444447;
+  color: #a8a29e;
+}
+
+html[data-theme='dark'] .purchaseInvoiceEditButton {
+  color: #d6d3d1;
+}
+
+html[data-theme='dark'] .purchaseInvoiceWarning {
+  background: #292317;
+  border-color: #854d0e;
+  color: #fde68a;
+}
+
+@media (max-width: 520px) {
+  .dealOverviewInvoiceStatus {
+    min-width: 0;
+    max-width: 48%;
+  }
+
+  .dealIncomingInvoiceHead {
+    align-items: flex-start;
+  }
+
+  .dealIncomingInvoiceActions {
+    flex-direction: column;
+    align-items: flex-end;
+  }
+
+  .purchaseInvoiceEditorActions {
+    grid-template-columns: 1fr 1fr;
+  }
+}
+
+.dealIncomingWorkflow-empty {
+  background: #fafaf9;
+}
+
+.dealIncomingWorkflow-unpaid {
+  background: #fffbeb;
+  border-color: #fde68a;
+}
+
+.dealIncomingWorkflow-paying {
+  background: #eff6ff;
+  border-color: #bfdbfe;
+}
+
+.dealIncomingWorkflow-paid {
+  background: #f0fdf4;
+  border-color: #bbf7d0;
+}
+
+html[data-theme='dark'] .dealIncomingWorkflow-unpaid {
+  background: #292317;
+  border-color: #854d0e;
+}
+
+html[data-theme='dark'] .dealIncomingWorkflow-paying {
+  background: #172238;
+  border-color: #1d4ed8;
+}
+
+html[data-theme='dark'] .dealIncomingWorkflow-paid {
+  background: #16281d;
+  border-color: #166534;
+}
