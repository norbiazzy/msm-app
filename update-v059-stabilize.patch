+type PowerOfAttorneyPayload = {
+  kind?: 'POWER_OF_ATTORNEY';
+  requestKey: string;
+  supplierName: string;
+  organization?: SellerType;
+  recipientName: string;
+  invoiceNumber?: string;
+  requestDate?: string;
+  goodsDescription: string;
+  comment?: string;
+};
+
+
+function powerOfAttorneyPayload(
+  value: Task['payload'],
+): PowerOfAttorneyPayload {
+  const source = value || {};
+
+  const readString = (key: string) => {
+    const item = source[key];
+    return typeof item === 'string'
+      ? item.trim()
+      : '';
+  };
+
+  const organizationValue =
+    readString('organization');
+
+  const organization =
+    organizationValue === 'ST' ||
+    organizationValue === 'MSM' ||
+    organizationValue === 'IP'
+      ? organizationValue
+      : undefined;
+
+  const kind =
+    readString('kind') ===
+    'POWER_OF_ATTORNEY'
+      ? 'POWER_OF_ATTORNEY'
+      : undefined;
+
+  return {
+    kind,
+    requestKey:
+      readString('requestKey'),
+    supplierName:
+      readString('supplierName'),
+    organization,
+    recipientName:
+      readString('recipientName'),
+    invoiceNumber:
+      readString('invoiceNumber') ||
+      undefined,
+    requestDate:
+      readString('requestDate') ||
+      undefined,
+    goodsDescription:
+      readString('goodsDescription'),
+    comment:
+      readString('comment') ||
+      undefined,
+  };
+}
