+
+
+/* MSM invoice request seller editor v0.5.3 */
+
+.invoiceRequestSellerEditor {
+  display: grid;
+  gap: 10px;
+  padding: 12px;
+  border: 1px solid #e7e5e4;
+  border-radius: 14px;
+  background: #fafaf9;
+}
+
+.invoiceRequestSellerHead {
+  display: flex;
+  align-items: flex-start;
+  justify-content: space-between;
+  gap: 12px;
+}
+
+.invoiceRequestSellerHead span,
+.invoiceRequestSellerHead strong {
+  display: block;
+}
+
+.invoiceRequestSellerHead span {
+  color: #78716c;
+  font-size: 11px;
+}
+
+.invoiceRequestSellerHead strong {
+  margin-top: 2px;
+  font-size: 16px;
+}
+
+.invoiceRequestSellerHead em {
+  max-width: 310px;
+  color: #78716c;
+  font-size: 11px;
+  font-style: normal;
+  line-height: 1.4;
+  text-align: right;
+}
+
+html[data-theme='dark']
+.invoiceRequestSellerEditor {
+  background: #242426;
+  border-color: #343437;
+}
+
+@media (max-width: 520px) {
+  .invoiceRequestSellerHead {
+    display: grid;
+  }
+
+  .invoiceRequestSellerHead em {
+    max-width: none;
+    text-align: left;
+  }
+}
