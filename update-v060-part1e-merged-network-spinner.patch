--- /dev/null
+++ b/frontend/src/networkStatus.css
@@ -0,0 +1,81 @@
+.networkStatusBanner {
+  position: fixed;
+  z-index: 9999;
+  top: max(12px, env(safe-area-inset-top));
+  left: 50%;
+  transform: translateX(-50%);
+  width: min(calc(100% - 24px), 520px);
+  box-sizing: border-box;
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  padding: 12px 14px;
+  border: 1px solid rgba(255, 255, 255, 0.14);
+  border-radius: 14px;
+  color: #fff;
+  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.22);
+  backdrop-filter: blur(12px);
+  -webkit-backdrop-filter: blur(12px);
+}
+
+.networkStatusBannerOffline {
+  background: rgba(47, 47, 52, 0.96);
+}
+
+.networkStatusBannerRestored {
+  background: rgba(31, 91, 61, 0.96);
+}
+
+.networkStatusBanner > div {
+  min-width: 0;
+  display: flex;
+  flex-direction: column;
+  gap: 2px;
+}
+
+.networkStatusBanner strong {
+  font-size: 14px;
+  line-height: 1.25;
+}
+
+.networkStatusBanner span {
+  font-size: 12px;
+  line-height: 1.35;
+  opacity: 0.82;
+}
+
+.networkStatusDot {
+  flex: 0 0 auto;
+  width: 9px;
+  height: 9px;
+  border-radius: 999px;
+  background: currentColor;
+  opacity: 1 !important;
+}
+
+.networkStatusSpinner {
+  flex: 0 0 auto;
+  width: 18px;
+  height: 18px;
+  box-sizing: border-box;
+  border-radius: 999px;
+  border: 2px solid rgba(255, 255, 255, 0.28);
+  border-top-color: currentColor;
+  opacity: 1 !important;
+  animation: networkStatusSpin 0.8s linear infinite;
+}
+
+@keyframes networkStatusSpin {
+  to {
+    transform: rotate(360deg);
+  }
+}
+
+@media (max-width: 640px) {
+  .networkStatusBanner {
+    top: max(8px, env(safe-area-inset-top));
+    width: calc(100% - 16px);
+    padding: 11px 12px;
+    border-radius: 12px;
+  }
+}
