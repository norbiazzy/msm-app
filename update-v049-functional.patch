+  gap: 7px;
+  padding-top: 10px;
+  border-top: 1px solid #f0efed;
+}
+
+.customerInvoiceHistoryTitle {
+  color: #78716c;
+  font-size: 11px;
+  font-weight: 800;
+}
+
+.customerInvoiceHistoryRow {
+  padding: 9px 10px;
+  border-radius: 11px;
+  background: #fafaf9;
+}
+
+.customerInvoiceHistoryRow b {
+  display: block;
+  font-size: 12px;
+}
+
+.primaryIncomingPicker {
+  display: grid;
+  gap: 8px;
+}
+
+.primaryIncomingSelected {
+  border: 1px solid #bfdbfe;
+  background: #eff6ff;
+}
+
+.invoiceTaskBrief {
+  display: grid;
+  grid-template-columns: .7fr 1.5fr 1fr;
+  gap: 12px;
+}
+
+.invoiceTaskBrief > div {
+  min-width: 0;
+}
+
+.invoiceTaskBrief b {
+  display: block;
+  margin-top: 4px;
+  overflow-wrap: anywhere;
+}
+
+.sellerTaskBadge {
+  display: inline-flex !important;
+  width: fit-content;
+  padding: 5px 9px;
+  border-radius: 999px;
+  background: #111;
+  color: #fff !important;
+  font-size: 12px;
+}
+
+.customerInvoiceTaskBox .versionList {
+  margin-top: 10px;
+}
+
+html[data-theme='dark'] .customerInvoiceBox,
+html[data-theme='dark'] .invoiceTaskBrief {
+  background: #1d1d1f;
+  border-color: #343437;
+}
+
+html[data-theme='dark'] .customerInvoiceHistory {
+  border-color: #303033;
+}
+
+html[data-theme='dark'] .customerInvoiceHistoryRow {
+  background: #242426;
+}
+
+html[data-theme='dark'] .customerInvoiceCurrent a,
+html[data-theme='dark'] .customerInvoiceHistoryRow a {
+  color: #f5f5f4;
+}
+
+html[data-theme='dark'] .primaryIncomingSelected {
+  background: #172033;
+  border-color: #1d4ed8;
+}
+
+html[data-theme='dark'] .sellerTaskBadge {
+  background: #f5f5f4;
+  color: #111 !important;
+}
+
+@media (max-width: 520px) {
+  .invoiceTaskBrief {
+    grid-template-columns: 1fr 1fr;
+  }
+
+  .invoiceTaskBrief > div:last-child {
+    grid-column: 1 / -1;
+  }
+}
