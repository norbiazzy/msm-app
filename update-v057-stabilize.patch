+
+/* MSM stabilization: invoice documents + supplier payment docs v0.5.7 */
+
+.dealOverviewInvoiceLink {
+  display: inline-flex;
+  align-items: center;
+  margin-top: 8px;
+  color: #171717;
+  font-size: 12px;
+  font-weight: 800;
+  text-decoration: underline;
+  text-underline-offset: 3px;
+}
+
+.dealIncomingSupplierList {
+  display: grid;
+  gap: 8px;
+  margin-top: 10px;
+}
+
+.dealIncomingSupplierRow {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 12px;
+  margin-top: 10px;
+  padding: 11px 12px;
+  border-radius: 12px;
+  background: #fafaf9;
+}
+
+.dealIncomingSupplierList .dealIncomingSupplierRow {
+  margin-top: 0;
+}
+
+.dealIncomingSupplierRow > div {
+  min-width: 0;
+}
+
+.dealIncomingSupplierRow b,
+.dealIncomingSupplierRow span {
+  display: block;
+}
+
+.dealIncomingSupplierRow span {
+  margin-top: 3px;
+  color: #78716c;
+  font-size: 11px;
+  overflow-wrap: anywhere;
+}
+
+.dealIncomingSupplierRow a {
+  flex-shrink: 0;
+  color: #171717;
+  font-size: 12px;
+  font-weight: 800;
+}
+
+.purchasePaymentDocuments {
+  display: grid;
+  gap: 9px;
+  padding: 11px 12px;
+  border: 1px solid #e7e5e4;
+  border-radius: 12px;
+  background: #fff;
+}
+
+.purchasePaymentDocumentsHead {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 10px;
+}
+
+.purchasePaymentDocumentsHead span,
+.purchasePaymentDocumentsHead b {
+  display: block;
+}
+
+.purchasePaymentDocumentsHead span {
+  color: #78716c;
+  font-size: 11px;
+}
+
+.purchasePaymentDocumentsHead b {
+  margin-top: 2px;
+  font-size: 13px;
+}
+
+.purchasePaymentFileList {
+  display: grid;
+  gap: 6px;
+  padding-top: 8px;
+  border-top: 1px solid #f0efed;
+}
+
+.purchasePaymentFileList a {
+  color: #171717;
+  font-size: 12px;
+  font-weight: 800;
+  overflow-wrap: anywhere;
+}
+
+.purchasePaymentFileMissing {
+  color: #a8a29e;
+  font-size: 11px;
+}
+
+html[data-theme='dark'] .dealOverviewInvoiceLink,
+html[data-theme='dark'] .dealIncomingSupplierRow a,
+html[data-theme='dark'] .purchasePaymentFileList a {
+  color: #f5f5f4;
+}
+
+html[data-theme='dark'] .dealIncomingSupplierRow,
+html[data-theme='dark'] .purchasePaymentDocuments {
+  background: #242426;
+  border-color: #343437;
+}
+
+html[data-theme='dark'] .purchasePaymentFileList {
+  border-color: #343437;
+}
+
+@media (max-width: 520px) {
+  .purchasePaymentDocumentsHead {
+    align-items: flex-start;
+  }
+
+  .purchasePaymentDocumentsHead .compactButton {
+    width: auto;
+  }
+}
