diff --git a/frontend/src/styles.css b/frontend/src/styles.css
index 6e045d0..8576545 100644
--- a/frontend/src/styles.css
+++ b/frontend/src/styles.css
@@ -2954,3 +2954,109 @@ html[data-theme='dark'] button.invoiceReturnReason.selected .invoiceReturnRadio
     width: 100%;
   }
 }
+
+/* MSM manager action cards v0.5.1 */
+
+.dealCardNeedsAction {
+  border-color: #f59e0b;
+  background: #fffdf5;
+  box-shadow:
+    0 5px 22px
+    rgba(180,83,9,.08);
+}
+
+.dealCardNeedsAction:hover {
+  border-color: #d97706;
+}
+
+.dealCardActionStatus {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  padding: 4px 8px;
+  border-radius: 999px;
+  background: #fef3c7;
+  color: #92400e;
+  font-size: 11px;
+  font-weight: 800;
+  white-space: nowrap;
+}
+
+.dealCardActionBox {
+  display: grid;
+  gap: 8px;
+  margin-top: 12px;
+  padding: 12px;
+  border: 1px solid #fde68a;
+  border-radius: 13px;
+  background: #fffbeb;
+  text-align: left;
+}
+
+.dealCardActionHead {
+  display: grid;
+  gap: 3px;
+}
+
+.dealCardActionHead strong {
+  color: #92400e;
+  font-size: 13px;
+}
+
+.dealCardActionHead span {
+  color: #78350f;
+  font-size: 12px;
+  font-weight: 700;
+}
+
+.dealCardActionBox p {
+  display: -webkit-box;
+  margin: 0;
+  overflow: hidden;
+  color: #57534e;
+  font-size: 11px;
+  line-height: 1.45;
+  -webkit-box-orient: vertical;
+  -webkit-line-clamp: 2;
+}
+
+.dealCardActionCta {
+  color: #92400e;
+  font-size: 12px;
+  font-weight: 900;
+}
+
+html[data-theme='dark']
+.dealCardNeedsAction {
+  border-color: #854d0e;
+  background: #211d16;
+  box-shadow:
+    0 5px 22px
+    rgba(245,158,11,.06);
+}
+
+html[data-theme='dark']
+.dealCardActionBox {
+  border-color: #713f12;
+  background: #292317;
+}
+
+html[data-theme='dark']
+.dealCardActionStatus {
+  background: #422006;
+  color: #fcd34d;
+}
+
+html[data-theme='dark']
+.dealCardActionHead strong,
+html[data-theme='dark']
+.dealCardActionHead span,
+html[data-theme='dark']
+.dealCardActionCta {
+  color: #fcd34d;
+}
+
+html[data-theme='dark']
+.dealCardActionBox p {
+  color: #d6d3d1;
+}
