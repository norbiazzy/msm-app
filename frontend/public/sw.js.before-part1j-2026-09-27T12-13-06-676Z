const APP_CACHE = 'msm-app-shell-v1';
const API_CACHE = 'msm-api-get-v1';

const APP_FALLBACKS = [
  '/',
  '/index.html',
];

async function warmAppShell() {
  const cache =
    await caches.open(APP_CACHE);

  const response =
    await fetch('/', {
      cache: 'no-store',
    });

  if (!response.ok) {
    throw new Error(
      'Не удалось загрузить оболочку приложения',
    );
  }

  await cache.put(
    '/',
    response.clone(),
  );

  await cache.put(
    '/index.html',
    response.clone(),
  );

  const html =
    await response.text();

  const assetUrls = [];
  const pattern =
    /(?:src|href)=["']([^"']+)["']/g;

  let match;

  while ((match = pattern.exec(html))) {
    try {
      const url =
        new URL(
          match[1],
          self.location.origin,
        );

      if (
        url.origin === self.location.origin &&
        !url.pathname.startsWith('/api/')
      ) {
        assetUrls.push(
          url.pathname + url.search,
        );
      }
    } catch {
      // Ignore invalid or unsupported URLs.
    }
  }

  await Promise.allSettled(
    [...new Set(assetUrls)]
      .map(async (url) => {
        const assetResponse =
          await fetch(url);

        if (assetResponse.ok) {
          await cache.put(
            url,
            assetResponse,
          );
        }
      }),
  );
}

self.addEventListener(
  'install',
  (event) => {
    event.waitUntil(
      warmAppShell()
        .finally(() => {
          self.skipWaiting();
        }),
    );
  },
);

self.addEventListener(
  'activate',
  (event) => {
    event.waitUntil(
      Promise.all([
        caches.keys()
          .then((keys) =>
            Promise.all(
              keys
                .filter(
                  (key) =>
                    key.startsWith('msm-') &&
                    ![
                      APP_CACHE,
                      API_CACHE,
                    ].includes(key)
                )
                .map((key) =>
                  caches.delete(key)
                ),
            ),
          ),
        self.clients.claim(),
      ]),
    );
  },
);

async function networkFirst(
  request,
  cacheName,
  fallbackRequests = [],
) {
  const cache =
    await caches.open(cacheName);

  try {
    const response =
      await fetch(request);

    if (response.ok) {
      await cache.put(
        request,
        response.clone(),
      );
    }

    return response;
  } catch (error) {
    const cached =
      await cache.match(request);

    if (cached) {
      return cached;
    }

    for (const fallback of fallbackRequests) {
      const fallbackResponse =
        await cache.match(fallback);

      if (fallbackResponse) {
        return fallbackResponse;
      }
    }

    throw error;
  }
}

async function staleWhileRevalidate(
  request,
) {
  const cache =
    await caches.open(APP_CACHE);

  const cached =
    await cache.match(request);

  const network =
    fetch(request)
      .then(async (response) => {
        if (response.ok) {
          await cache.put(
            request,
            response.clone(),
          );
        }

        return response;
      });

  if (cached) {
    void network.catch(
      () => undefined,
    );

    return cached;
  }

  return network;
}

self.addEventListener(
  'fetch',
  (event) => {
    const request =
      event.request;

    if (request.method !== 'GET') {
      return;
    }

    const url =
      new URL(request.url);

    if (url.origin !== self.location.origin) {
      return;
    }

    if (request.mode === 'navigate') {
      event.respondWith(
        networkFirst(
          request,
          APP_CACHE,
          APP_FALLBACKS,
        ),
      );
      return;
    }

    if (url.pathname.startsWith('/api/')) {
      event.respondWith(
        networkFirst(
          request,
          API_CACHE,
        ),
      );
      return;
    }

    event.respondWith(
      staleWhileRevalidate(request),
    );
  },
);
