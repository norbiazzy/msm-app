export function BlockOfficeMobileNav() {
  function goSearch() {
    if (
      !window.location.hash ||
      !window.location.hash.startsWith(
        '#home',
      )
    ) {
      window.location.hash =
        '#home';
    }

    window.setTimeout(
      () => {
        const input =
          document.getElementById(
            'bo-deal-search',
          ) as HTMLInputElement | null;

        if (input) {
          input.focus();

          input.scrollIntoView({
            behavior: 'smooth',
            block: 'center',
          });
        }
      },
      80,
    );
  }

  return (
    <nav
      className="boMobileNav"
      aria-label="Основная навигация"
    >
      <button
        type="button"
        className="boMobileEmpty"
        aria-label="Свободная кнопка 1"
        disabled
      >
        <b>·</b>
        <span>&nbsp;</span>
      </button>

      <button
        type="button"
        className="boMobileEmpty"
        aria-label="Свободная кнопка 2"
        disabled
      >
        <b>·</b>
        <span>&nbsp;</span>
      </button>

      <a href="#tasks">
        <b>✓</b>
        <span>Задачи</span>
      </a>

      <a href="#home">
        <b>▦</b>
        <span>Сделки</span>
      </a>

      <button
        type="button"
        onClick={goSearch}
      >
        <b>⌕</b>
        <span>Поиск</span>
      </button>
    </nav>
  );
}
