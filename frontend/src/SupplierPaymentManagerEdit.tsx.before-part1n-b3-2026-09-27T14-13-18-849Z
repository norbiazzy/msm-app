import {
  useState,
} from 'react';

import {
  resubmitSupplierPaymentTask,
} from './api';

import type {
  SupplierPurchase,
} from './types';


function formatMoneyInput(
  value: string,
) {

  const normalized =
    value
      .replace(/\s+/g, '')
      .replace(',', '.')
      .replace(/[^0-9.]/g, '');

  if (!normalized) {
    return '';
  }


  const firstDot =
    normalized.indexOf('.');


  const integerPart =
    (
      firstDot >= 0
        ? normalized.slice(
            0,
            firstDot
          )
        : normalized
    ) || '0';


  const decimalPart =
    firstDot >= 0
      ? normalized
          .slice(
            firstDot + 1
          )
          .replace(
            /\./g,
            ''
          )
          .slice(
            0,
            2
          )
      : null;


  const formattedInteger =
    integerPart
      .replace(
        /^0+(?=\d)/,
        ''
      )
      .replace(
        /\B(?=(\d{3})+(?!\d))/g,
        ' '
      );


  return decimalPart !== null
    ? formattedInteger +
        ',' +
        decimalPart
    : formattedInteger;
}


function parseMoney(
  value: string,
) {

  const normalized =
    value
      .replace(/\s+/g, '')
      .replace(',', '.');


  if (!normalized) {
    return undefined;
  }


  const parsed =
    Number(normalized);


  return Number.isFinite(
    parsed
  )
    ? parsed
    : undefined;
}


export function SupplierPaymentManagerEdit({
  taskId,
  actorId,
  purchase,
  urgent,
  onResubmitted,
}: {
  taskId: string;
  actorId: string;
  purchase: SupplierPurchase;
  urgent: boolean;
  onResubmitted:
    () =>
      void |
      Promise<void>;
}) {

  const [
    supplierName,
    setSupplierName,
  ] = useState(
    purchase.supplierName ||
      ''
  );


  const [
    invoiceNumber,
    setInvoiceNumber,
  ] = useState(
    purchase
      .incomingInvoiceNumber ||
      ''
  );


  const [
    amount,
    setAmount,
  ] = useState(
    purchase.requestedAmount
      ? formatMoneyInput(
          String(
            purchase
              .requestedAmount
          )
        )

      : purchase
          .incomingInvoiceAmount
        ? formatMoneyInput(
            String(
              purchase
                .incomingInvoiceAmount
            )
          )

        : ''
  );


  const [
    comment,
    setComment,
  ] = useState(
    purchase.comment ||
      ''
  );


  const [
    urgentValue,
    setUrgentValue,
  ] = useState(
    urgent
  );


  const [
    saving,
    setSaving,
  ] = useState(false);


  const [
    error,
    setError,
  ] = useState('');


  async function submit() {

    const parsedAmount =
      parseMoney(amount);


    if (
      amount.trim() &&
      parsedAmount ===
        undefined
    ) {

      setError(
        'Проверьте сумму.'
      );

      return;
    }


    setSaving(true);
    setError('');


    try {

      await resubmitSupplierPaymentTask(
        taskId,
        {
          actorId,

          supplierName:
            supplierName
              .trim() ||
            undefined,

          incomingInvoiceNumber:
            invoiceNumber
              .trim() ||
            undefined,

          amount:
            parsedAmount,

          comment:
            comment.trim() ||
            undefined,

          urgent:
            urgentValue,
        },
      );


      await onResubmitted();


    } catch (e) {

      setError(
        e instanceof Error
          ? e.message
          : String(e)
      );


    } finally {

      setSaving(false);
    }
  }


  return (

    <div className="managerResubmitPanel supplierManagerEdit">

      <div className="managerResubmitHead">

        <strong>
          Исправить оплату поставщику
        </strong>

        <span>
          Все текущие данные сохранены.
          Исправьте только то, что нужно,
          и повторно отправьте бухгалтерии.
        </span>

      </div>


      <label className="field">

        <span>
          Поставщик
        </span>

        <input
          value={supplierName}
          disabled={saving}
          onChange={(event) =>
            setSupplierName(
              event.target.value
            )
          }
        />

      </label>


      <label className="field">

        <span>
          № входящего счёта
        </span>

        <input
          value={invoiceNumber}
          disabled={saving}
          onChange={(event) =>
            setInvoiceNumber(
              event.target.value
            )
          }
          placeholder="Не указан"
        />

      </label>


      <label className="field">

        <span>
          Сумма к оплате
        </span>

        <input
          inputMode="decimal"
          value={amount}
          disabled={saving}
          onChange={(event) =>
            setAmount(
              formatMoneyInput(
                event.target.value
              )
            )
          }
          placeholder="0"
        />

      </label>


      <label className="field">

        <span>
          Комментарий
        </span>

        <textarea
          rows={4}
          value={comment}
          disabled={saving}
          onChange={(event) =>
            setComment(
              event.target.value
            )
          }
        />

      </label>


      <label className="urgentToggle">

        <input
          type="checkbox"
          checked={urgentValue}
          disabled={saving}
          onChange={(event) =>
            setUrgentValue(
              event.target.checked
            )
          }
        />

        <span>
          Срочно
        </span>

      </label>


      {error && (

        <div className="error">
          {error}
        </div>

      )}


      <button
        type="button"
        className="primary wide"
        disabled={saving}
        onClick={() =>
          void submit()
        }
      >

        {
          saving
            ? 'Отправляем…'
            : 'Сохранить и повторно отправить бухгалтерии'
        }

      </button>

    </div>
  );
}
