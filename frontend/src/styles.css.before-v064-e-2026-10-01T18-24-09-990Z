}

.boManagerNote span {
  display: block;
  margin-bottom: 3px;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: .04em;
  text-transform: uppercase;
}

.boManagerNote strong {
  color: var(--bo-text);
  font-weight: 650;
}

.boTasksBlock {
  margin-top: 13px;
}

.boTasksTitle {
  margin-bottom: 7px;
  color: var(--bo-muted);
  font-size: 11px;
  font-weight: 900;
  letter-spacing: .04em;
}

.boTaskStack {
  display: flex;
  flex-direction: column;
  gap: 7px;
}

.boTaskRow {
  display: grid;
  grid-template-columns: 5px minmax(0, 1fr) auto;
  align-items: stretch;
  gap: 10px;
  min-height: 54px;
  overflow: hidden;
  border: 1px solid var(--bo-line);
  border-radius: 6px;
  background: var(--bo-panel);
  color: var(--bo-text);
  text-decoration: none;
}

.boTaskBar { background: var(--bo-blue); }
.boTask-new .boTaskBar { background: var(--bo-stone); }
.boTask-work .boTaskBar { background: var(--bo-blue); }
.boTask-fix .boTaskBar { background: var(--bo-red); }
