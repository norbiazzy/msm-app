  --bo-stone: #9aa3ad;
  --bo-blue: #72a9d0;
  --bo-gold: #d4aa50;
  --bo-red: #d27368;
  --bo-green: #78a86b;
  --bo-purple: #8b7a9d;
  --bo-lava: #e1834d;
}

.boDealsHome {
  color: var(--bo-text);
}

.boToolbar {
  display: flex;
  align-items: center;
  gap: 10px;
  justify-content: space-between;
  margin-bottom: 14px;
}

.boSearch {
  flex: 1 1 360px;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 8px;
  border: 1px solid var(--bo-line);
  border-radius: 7px;
  background: var(--bo-panel);
  color: var(--bo-muted);
  padding: 0 12px;
}

.boSearch input {
  width: 100%;
  border: 0;
  outline: 0;
  background: transparent;
  color: var(--bo-text);
  padding: 11px 0;
}

.boToolbarActions {
  display: flex;
  align-items: center;
  gap: 8px;
}

.boViewToggle {
  display: flex;
  align-items: center;
  gap: 3px;
  padding: 3px;
  border: 1px solid var(--bo-line);
  border-radius: 8px;
  background: var(--bo-panel-2);
}

.boViewToggle button {
  min-width: 42px;
  min-height: 38px;
  border: 1px solid transparent;
  border-radius: 6px;
  background: transparent;
  color: var(--bo-text);
  cursor: pointer;
}

.boViewToggle button.active {
  border-color: var(--bo-line);
  background: var(--bo-panel);
  box-shadow: var(--bo-shadow);
}

.boCreateDeal {
  min-height: 44px;
  border: 0;
  border-radius: 7px;
  background: var(--bo-accent);
  color: #fff;
  font-weight: 800;
  padding: 9px 13px;
  cursor: pointer;
}

.boDealGrid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12px;
}

.boDealCard {
  position: relative;
  overflow: hidden;
  border: 1px solid var(--bo-line);
  border-radius: 8px;
  background: var(--bo-panel);
  color: var(--bo-text);
  padding: 15px;
  box-shadow: var(--bo-shadow);
  cursor: pointer;
}

.boDealCard::before {
  content: '';
  position: absolute;
  inset: 0 auto 0 0;
  width: 5px;
  background: var(--bo-stone);
}

.boDealCard.boTone-done::before { background: var(--bo-green); }
.boDealCard.boTone-work::before { background: var(--bo-blue); }
.boDealCard.boTone-wait::before { background: var(--bo-gold); }
.boDealCard.boTone-fix::before { background: var(--bo-red); }
.boDealCard.boTone-closed::before { background: var(--bo-purple); }

