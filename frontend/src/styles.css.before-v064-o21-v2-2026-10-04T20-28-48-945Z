/* PART_V064_O18_V2_TASK_UPLOAD_PROGRESS */
.taskUploadInline {
  grid-column: 1 / -1;
  display: grid;
  gap: 7px;
  width: 100%;
  margin-top: 11px;
  padding-top: 11px;
  border-top: 1px solid rgba(255,255,255,.08);
  text-align: left;
}

.taskUploadTop,
.taskUploadGhostHead {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12px;
}

.taskUploadTop strong,
.taskUploadGhostHead strong {
  color: var(--bo-text, #f3f5f7);
  font-size: 13px;
  font-weight: 800;
  line-height: 1.35;
}

.taskUploadTop > b,
.taskUploadGhostHead > b {
  flex: 0 0 auto;
  color: #9db5cc;
  font-size: 12px;
  font-weight: 800;
}

.taskUploadBar {
  overflow: hidden;
  width: 100%;
  height: 5px;
  border-radius: 999px;
  background: rgba(255,255,255,.08);
}

.taskUploadBar > div {
  height: 100%;
  border-radius: inherit;
  background: currentColor;
  color: #84a8c8;
  transition: width .18s ease;
}

.taskUploadMeta {
  overflow: hidden;
  color: var(--bo-muted, #9ca8b4);
  font-size: 11px;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.taskUploadGhost {
  display: grid !important;
  gap: 9px !important;
  width: 100% !important;
  margin: 0 0 10px !important;
  padding: 14px 15px !important;
  cursor: default !important;
  text-align: left !important;
}

.taskUploadGhostHead > div {
  display: grid;
  gap: 3px;
  min-width: 0;
}

.taskUploadGhostHead span {
  overflow: hidden;
  color: var(--bo-muted, #9ca8b4);
  font-size: 12px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.taskUpload-success .taskUploadBar > div { color: #78a987; }
.taskUpload-success .taskUploadTop strong,
.taskUpload-success .taskUploadGhostHead strong { color: #8fbd9b; }
.taskUpload-error .taskUploadBar > div { color: #d87e70; }
.taskUpload-error .taskUploadTop strong,
.taskUpload-error .taskUploadGhostHead strong { color: #ef8b7c; }

@media (max-width: 640px) {
  .taskUploadGhost { padding: 12px !important; }
  .taskUploadMeta { white-space: normal; }
}
/* END_PART_V064_O18_V2_TASK_UPLOAD_PROGRESS */

