  align-items: center;
  justify-content: space-between;
  gap: 8px;
}

.boStatus {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  border-radius: 4px;
  padding: 5px 8px;
  font-size: 12px;
  font-weight: 900;
  white-space: nowrap;
}

