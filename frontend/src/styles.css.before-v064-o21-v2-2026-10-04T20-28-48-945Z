}


/* MSM v0.4.2 UI fixes */


/* --------------------------------------------------
   Mobile horizontal overflow
-------------------------------------------------- */

html,
body,
#root {
  width: 100%;
  max-width: 100%;
  overflow-x: hidden;
}

body {
  position: relative;
}

.shell {
  width: 100%;
  max-width: 760px;
  overflow-x: clip;
}

.content,
.form,
.infoBox,
.invoiceBlock,
.paymentBox,
.purchaseBox,
.purchaseCard,
.reviewBox,
.correctionBox,
.detailHero,
.dealCard,
.taskCard,
.versionRow,
.paymentRow,
.backgroundUploadCard {
  min-width: 0;
  max-width: 100%;
}

.dealTop > div,
.taskCardMain,
.versionRow > div,
.paymentRow > div,
.purchaseCardTop > div {
  min-width: 0;
}

.versionRow b,
.versionRow span,
.versionRow a,
.paymentRow b,
.paymentRow span,
.paymentRow em,
.purchaseFiles a,
.taskCard strong,
.taskCard span {
  overflow-wrap: anywhere;
  word-break: break-word;
}

input,
textarea,
select,
button {
  min-width: 0;
  max-width: 100%;
}

textarea {
  resize: vertical;
}

img,
video,
canvas,
svg {
  max-width: 100%;
}

.actions,
.inline,
.segmented,
.paymentActions {
  min-width: 0;
}

.actions {
  grid-template-columns:
    minmax(0, 1fr)
    minmax(0, 2fr);
}

.inline {
  grid-template-columns:
    minmax(0, 1.3fr)
