  width: 9px;
  height: 9px;
  border-radius: 1px;
  background: currentColor;
}

.boStatus-done { color: var(--bo-green); }
.boStatus-work,
.boStatus-new { color: var(--bo-blue); }
.boStatus-wait { color: var(--bo-gold); }
.boStatus-fix { color: var(--bo-red); }
.boStatus-closed { color: var(--bo-purple); }

.boDealDate {
  color: var(--bo-muted);
  font-size: 12px;
}

.boManagerNote {
  margin-top: 10px;
  padding: 9px 10px;
  border-radius: 5px;
  background: var(--bo-panel-2);
  color: var(--bo-muted);
