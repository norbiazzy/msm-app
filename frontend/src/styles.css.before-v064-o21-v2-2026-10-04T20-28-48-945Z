/* Supplier payment options: fix the oversized / split checkbox cards */
.boShell label[data-bo-payment-choice] {
  box-sizing: border-box;
  display: inline-grid !important;
  grid-template-columns: 28px minmax(0, 1fr) !important;
  align-items: center !important;
  gap: 13px !important;
  width: calc(50% - 7px) !important;
  min-height: 82px !important;
  vertical-align: top !important;
  margin: 6px 10px 6px 0 !important;
  border: 1px solid var(--bo-line) !important;
  border-radius: 8px !important;
  background: var(--bo-panel) !important;
  color: var(--bo-text) !important;
  padding: 14px 16px !important;
  cursor: pointer !important;
  box-shadow: none !important;
}

.boShell label[data-bo-payment-choice]:nth-of-type(even) {
  margin-right: 0 !important;
}

.boShell label[data-bo-payment-choice] input[type="checkbox"] {
  appearance: none;
  -webkit-appearance: none;
  width: 21px !important;
  height: 21px !important;
  min-width: 21px !important;
  min-height: 21px !important;
  margin: 0 !important;
  border: 2px solid var(--bo-stone) !important;
  border-radius: 4px !important;
  background: var(--bo-panel-2) !important;
  display: grid;
  place-items: center;
  cursor: pointer;
}

.boShell label[data-bo-payment-choice] input[type="checkbox"]::after {
  content: '';
  width: 9px;
  height: 5px;
  border-left: 2px solid #fff;
  border-bottom: 2px solid #fff;
  transform: rotate(-45deg) scale(0);
  transition: transform .12s ease;
}

.boShell label[data-bo-payment-choice] input[type="checkbox"]:checked {
  border-color: var(--bo-green) !important;
  background: var(--bo-green) !important;
}

.boShell label[data-bo-payment-choice] input[type="checkbox"]:checked::after {
  transform: rotate(-45deg) scale(1);
}

.boShell label[data-bo-payment-choice]:has(input:checked) {
  border-color: color-mix(in srgb, var(--bo-green) 60%, var(--bo-line)) !important;
  background: color-mix(in srgb, var(--bo-green) 9%, var(--bo-panel)) !important;
}

.boShell label[data-bo-payment-choice] > div,
.boShell label[data-bo-payment-choice] > span:not(:first-child) {
