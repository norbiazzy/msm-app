/* PART_V064_I_TASK_LIST_ERGONOMICS */

/* =========================
   TASK LIST — ERGONOMICS
   ========================= */

.boView-tasks .content {
  max-width: 1040px;
  margin: 0 auto;
}

/* second level title should not compete with page title */
.boView-tasks .content > h2,
.boView-tasks .sectionTitle,
.boView-tasks .taskColumnTitle,
.boView-tasks .taskListTitle {
  letter-spacing: -.02em;
}

.boView-tasks .sectionTitle,
.boView-tasks .taskColumnTitle,
.boView-tasks .taskListTitle {
  font-size: clamp(28px, 2.6vw, 34px);
  line-height: 1.08;
}

.boView-tasks .taskGroupTitle,
.boView-tasks .taskSectionTitle,
.boView-tasks .taskLaneTitle {
  font-size: 13px;
  font-weight: 900;
  letter-spacing: .01em;
}

/* list group spacing */
.boView-tasks .taskGroup,
.boView-tasks .taskLane,
.boView-tasks .taskSection {
  margin-top: 10px;
}

/* main card */
.boView-tasks .taskCard {
  position: relative;
  overflow: hidden;
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 10px 12px;
  align-items: start;
  min-height: 126px;
  padding: 15px 15px 14px 16px;
  border: 1px solid var(--bo-line);
  border-radius: 9px;
  background: linear-gradient(180deg, color-mix(in srgb, var(--bo-panel) 92%, #000 8%) 0%, var(--bo-panel) 100%);
  box-shadow: var(--bo-shadow);
}

.boView-tasks .taskCard::before {
  content: '';
  position: absolute;
  inset: 0 auto 0 0;
  width: 4px;
  background: var(--bo-blue);
  opacity: .95;
}

.boView-tasks .taskCard.task-new::before,
.boView-tasks .taskCard[data-status='NEW']::before {
  background: var(--bo-gold);
}

.boView-tasks .taskCard.task-need-data::before,
.boView-tasks .taskCard[data-status='NEED_DATA']::before {
  background: var(--bo-red);
}

.boView-tasks .taskCard.task-done::before,
.boView-tasks .taskCard[data-status='DONE']::before {
  background: var(--bo-green);
}

/* left content */
.boView-tasks .taskCardHead,
.boView-tasks .taskCardTop,
.boView-tasks .taskCardHeader {
  display: flex;
  flex-direction: column;
  gap: 4px;
  min-width: 0;
}

.boView-tasks .taskCardTitle,
.boView-tasks .taskCard h3,
.boView-tasks .taskCard h4 {
  margin: 0;
  color: var(--bo-text);
  font-size: 16px;
  line-height: 1.24;
  letter-spacing: -.015em;
}

.boView-tasks .taskCardClient,
.boView-tasks .taskCard small,
.boView-tasks .taskCard .taskCardSub {
  color: var(--bo-muted);
  font-size: 12px;
  line-height: 1.35;
}

/* deal number becomes more visible */
.boView-tasks .taskCardDeal,
.boView-tasks .taskCardDealNumber,
.boView-tasks .dealNumber,
.boView-tasks .taskCard b.deal,
.boView-tasks .taskCard .internalNumber {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  margin-top: 2px;
  color: var(--bo-text);
  font-size: 15px;
  font-weight: 900;
  line-height: 1.2;
  letter-spacing: .005em;
}

.boView-tasks .taskCardDeal::before,
.boView-tasks .taskCardDealNumber::before,
.boView-tasks .dealNumber::before,
.boView-tasks .taskCard .internalNumber::before {
  content: '■';
  color: var(--bo-accent);
  font-size: 9px;
  transform: translateY(-.5px);
}

/* invoice/org line */
.boView-tasks .taskCardInvoiceMeta,
.boView-tasks .taskCardMetaLine,
.boView-tasks .taskCardSellerMeta {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  align-items: center;
  margin-top: 5px;
}

.boView-tasks .taskCardInvoiceMeta .metaPill,
.boView-tasks .taskCardMetaLine .metaPill,
.boView-tasks .taskCardSellerMeta .metaPill {
  display: inline-flex;
  align-items: center;
  min-height: 24px;
  border: 1px solid var(--bo-line);
  border-radius: 999px;
  background: var(--bo-panel-2);
  color: var(--bo-muted);
  font-size: 11px;
  font-weight: 850;
  padding: 4px 8px;
  white-space: nowrap;
}

.boView-tasks .taskCardInvoiceMeta .metaPill strong,
.boView-tasks .taskCardMetaLine .metaPill strong,
.boView-tasks .taskCardSellerMeta .metaPill strong {
  color: var(--bo-text);
  margin-left: 4px;
}

/* created + footer */
.boView-tasks .taskCardFooter,
.boView-tasks .taskMetaFooter {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8px 12px;
  margin-top: 8px;
  color: var(--bo-muted);
  font-size: 11px;
}

/* right side status */
.boView-tasks .taskCardSide,
.boView-tasks .taskCardStatusWrap,
.boView-tasks .taskStatusSlot {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: space-between;
  gap: 10px;
  min-width: 88px;
  height: 100%;
}

.boView-tasks .statusPill,
.boView-tasks .taskCardStatus,
.boView-tasks .taskStatusBadge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 29px;
  padding: 6px 9px;
  border-radius: 5px;
  border: 1px solid var(--bo-line);
  background: var(--bo-panel-2);
  color: var(--bo-blue);
  font-size: 11px;
  font-weight: 900;
  white-space: nowrap;
}

.boView-tasks .statusPill.new,
.boView-tasks .taskCardStatus.new,
.boView-tasks .taskStatusBadge.new {
  color: var(--bo-gold);
}

.boView-tasks .statusPill.need-data,
.boView-tasks .taskCardStatus.need-data,
.boView-tasks .taskStatusBadge.need-data {
  color: #9b6dff;
}

.boView-tasks .statusPill.done,
.boView-tasks .taskCardStatus.done,
.boView-tasks .taskStatusBadge.done {
  color: var(--bo-green);
}

/* need-data return note inside card */
.boView-tasks .taskNeedDataBox,
.boView-tasks .needDataBox,
.boView-tasks .managerFixCard {
  margin-top: 10px;
  border: 1px solid color-mix(in srgb, var(--bo-gold) 40%, var(--bo-line));
  border-radius: 8px;
  background: color-mix(in srgb, var(--bo-gold) 12%, var(--bo-panel));
  padding: 11px 12px;
}

.boView-tasks .taskNeedDataBox strong,
.boView-tasks .needDataBox strong,
.boView-tasks .managerFixCard strong {
  display: block;
  margin: 0 0 4px;
  color: #ffbe3d;
  font-size: 14px;
  font-weight: 900;
}

.boView-tasks .taskNeedDataBox p,
.boView-tasks .needDataBox p,
.boView-tasks .managerFixCard p {
  margin: 0 0 4px;
  color: var(--bo-text);
  font-size: 12px;
  line-height: 1.45;
}

.boView-tasks .taskNeedDataBox a,
.boView-tasks .needDataBox a,
.boView-tasks .managerFixCard a {
  display: inline-flex;
  margin-top: 5px;
  color: #ffbe3d;
  font-size: 12px;
  font-weight: 900;
  text-decoration: none;
}

/* summary counter blocks */
.boView-tasks .taskCounter,
.boView-tasks .laneCounter,
.boView-tasks .taskCountBadge {
  min-width: 38px;
  min-height: 38px;
  border-radius: 8px;
  font-size: 15px;
  font-weight: 900;
}

/* mobile */
@media (max-width: 720px) {
  .boView-tasks .taskCard {
    grid-template-columns: 1fr;
    gap: 8px;
    min-height: 0;
    padding: 13px 12px 12px 14px;
  }

  .boView-tasks .taskCardSide,
  .boView-tasks .taskCardStatusWrap,
  .boView-tasks .taskStatusSlot {
    min-width: 0;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }

  .boView-tasks .taskCardTitle,
  .boView-tasks .taskCard h3,
  .boView-tasks .taskCard h4 {
    font-size: 15px;
  }

  .boView-tasks .taskCardDeal,
  .boView-tasks .taskCardDealNumber,
  .boView-tasks .dealNumber,
  .boView-tasks .taskCard .internalNumber {
    font-size: 14px;
  }

  .boView-tasks .taskCardInvoiceMeta,
  .boView-tasks .taskCardMetaLine,
  .boView-tasks .taskCardSellerMeta,
  .boView-tasks .taskCardFooter,
  .boView-tasks .taskMetaFooter {
    gap: 6px;
  }

  .boView-tasks .statusPill,
  .boView-tasks .taskCardStatus,
  .boView-tasks .taskStatusBadge {
    min-height: 27px;
    font-size: 10px;
  }
}

