+function saveCachedCurrentUser(
+  user: CurrentUser,
+) {
+  try {
+    window.localStorage.setItem(
+      CURRENT_USER_CACHE_KEY,
+      JSON.stringify(user),
+    );
+  } catch {
+    // Offline fallback is optional.
+  }
+}
