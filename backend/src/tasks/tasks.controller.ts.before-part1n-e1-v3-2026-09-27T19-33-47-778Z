import { Body, Controller, Get, Param, Patch, Post } from '@nestjs/common';
import { TaskStatus } from '@prisma/client';
import { TasksService } from './tasks.service';

@Controller('tasks')
export class TasksController {
  constructor(private readonly tasks: TasksService) {}

  @Get()
  list() {
    return this.tasks.list();
  }

  @Post('power-of-attorney')
  createPowerOfAttorney(
    @Body() body: {
      dealId: string;
      actorId: string;
      urgent?: boolean;
      requestKey: string;
      supplierName: string;
      organization: 'ST' | 'MSM' | 'IP';
      recipientName: string;
      invoiceNumber?: string;
      requestDate?: string;
      goodsDescription: string;
      comment?: string;
    },
  ) {
    return this.tasks.createPowerOfAttorney(body);
  }

  @Post(':id/complete-power-of-attorney')
  completePowerOfAttorney(
    @Param('id') id: string,
    @Body() body: { actorId: string },
  ) {
    return this.tasks.completePowerOfAttorney(
      id,
      body.actorId,
    );
  }

  @Post(':id/complete-balance-correction')
  completeBalanceCorrection(
    @Param('id') id: string,
    @Body() body: { actorId: string },
  ) {
    return this.tasks.completeBalanceCorrection(
      id,
      body.actorId,
    );
  }


  @Post(':id/return')
  returnInvoiceRequest(
    @Param('id') id: string,
    @Body() body: {
      actorId: string;
      reasonCode: string;
      comment?: string;
    },
  ) {
    return this.tasks.returnInvoiceRequest(id, body);
  }

  @Patch(':id/status')
  updateStatus(@Param('id') id: string, @Body() body: { status: TaskStatus; assigneeId?: string }) {
    return this.tasks.updateStatus(id, body.status, body.assigneeId);
  }


  @Post(':id/return-to-manager')
  returnToManager(
    @Param('id') id: string,

    @Body() body: {
      actorId: string;
      reasonCode: string;
      comment?: string;
    },
  ) {

    return this.tasks
      .returnToManager(
        id,
        body,
      );
  }


  @Post(':id/resubmit-to-accounting')
  resubmitToAccounting(
    @Param('id') id: string,

    @Body() body: {
      actorId: string;
      description?: string;
      urgent?: boolean;
    },
  ) {

    return this.tasks
      .resubmitToAccounting(
        id,
        body,
      );
  }


  @Post(':id/resubmit-supplier-payment')
  resubmitSupplierPayment(
    @Param('id') id: string,

    @Body() body: {
      actorId: string;
      supplierName?: string;
      incomingInvoiceNumber?: string;
      amount?: number;
      comment?: string;
      urgent?: boolean;
    },
  ) {

    return this.tasks
      .resubmitSupplierPayment(
        id,
        body,
      );
  }
}
