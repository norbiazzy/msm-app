+/* MSM task card upload progress v0.6.0 part 1B */
+
+.taskCard[role='button'] {
+  cursor: pointer;
+}
+
+.taskCard[role='button']:focus-visible {
+  outline: 2px solid #2563eb;
+  outline-offset: 2px;
+}
+
+.taskCardWithUpload {
+  flex-wrap: wrap;
+  align-items: flex-start;
+}
+
+.taskCardWithUpload .taskCardMain {
+  flex: 1 1 240px;
+}
+
+.taskCardWithUpload .taskState {
+  flex: 0 0 auto;
+}
+
+.taskCardUploadState {
+  flex: 0 0 100%;
+  display: grid;
+  gap: 7px;
+  margin-top: 3px;
+  padding-top: 10px;
+  border-top: 1px solid #e7e5e4;
+  cursor: default;
+}
+
+.taskCardUploadTop {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 10px;
+}
+
+.taskCardUploadTop strong {
+  min-width: 0;
+  font-size: 12px;
+}
+
+.taskCardUploadTop b {
+  flex: 0 0 auto;
+  color: #2563eb;
+  font-size: 11px;
+}
+
+.taskCardUploadBar {
+  height: 6px;
+  overflow: hidden;
+  border-radius: 999px;
+  background: #dbeafe;
+}
+
+.taskCardUploadBar > span {
+  display: block;
+  height: 100%;
+  margin: 0 !important;
+  border-radius: inherit;
+  background: #3b82f6;
+  transition: width 180ms ease;
+}
+
+.taskCardUploadMeta {
+  margin: 0 !important;
+  color: #64748b !important;
+  font-size: 10px !important;
+  overflow-wrap: anywhere;
+}
+
+.taskCardUpload-success .taskCardUploadBar > span {
+  background: #22c55e;
+}
+
+.taskCardUpload-success .taskCardUploadTop b {
+  color: #15803d;
+}
+
+.taskCardUpload-error .taskCardUploadBar > span {
+  background: #ef4444;
+}
+
+.taskCardUpload-error .taskCardUploadTop b {
+  color: #b91c1c;
+}
+
+.taskCardUploadError {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 10px;
+}
+
+.taskCardUploadError .taskCardUploadMeta {
+  color: #b91c1c !important;
+}
+
+html[data-theme='dark'] .taskCardUploadState {
+  border-color: #343437;
+}
+
+html[data-theme='dark'] .taskCardUploadBar {
+  background: #303846;
+}
+
+html[data-theme='dark'] .taskCardUploadMeta {
+  color: #a8a29e !important;
+}
+
+@media (max-width: 520px) {
+  .taskCardUploadError {
+    align-items: stretch;
+    flex-direction: column;
+  }
+
+  .taskCardUploadError > button {
+    width: 100%;
+  }
+}
+
 /* MSM deal layout v0.5.5 */
