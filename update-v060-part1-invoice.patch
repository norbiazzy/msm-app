+function documentNumberFromFileName(
+  fileName: string,
+) {
+  const baseName =
+    fileName
+      .replace(/\.[^.]+$/, '')
+      .replace(/_/g, ' ')
+      .trim();
+
+  const byMarker =
+    baseName.match(
+      /(?:№|#)\s*([A-Za-zА-Яа-яЁё0-9][A-Za-zА-Яа-яЁё0-9./-]{0,30})/u
