+      /(?:сч[её]т(?:а)?|invoice)\s*(?:n(?:o)?\.?)?\s*[-–—:]?\s*([A-Za-zА-Яа-яЁё0-9][A-Za-zА-Яа-яЁё0-9./-]{0,30})/iu
+    );
+
+  const candidate =
+    (byMarker?.[1] || byInvoiceWord?.[1] || '')
+      .replace(/[.,;:]+$/, '')
+      .trim();
+
+  return /\d/u.test(candidate)
+    ? candidate
+    : '';
+}
