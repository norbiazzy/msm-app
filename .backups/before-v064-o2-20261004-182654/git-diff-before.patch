+  font-weight: 950;
+}
+
+.dealWorkspaceCContact {
+  display: grid;
+  gap: 2px;
+  margin-top: 7px;
+}
+
+.dealWorkspaceCContact strong {
+  font-size: 12px;
+}
+
+.dealWorkspaceCContact span {
+  color:
+    var(--bo-muted, #78828c);
