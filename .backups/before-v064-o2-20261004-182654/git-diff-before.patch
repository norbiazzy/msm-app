+}
+
+/* Main metadata line approved in Variant A */
+.boView-tasks .taskVariantAMeta {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 5px;
+  margin-top: 8px;
+}
+
+.boView-tasks .taskVariantADeal {
+  display: inline-flex;
+  align-items: center;
+  gap: 5px;
+  color: var(--bo-text);
+  font-size: 14px;
+  font-weight: 950;
+  white-space: nowrap;
+}
+
+.boView-tasks .taskVariantADeal::before {
+  content: '■';
+  color: var(--bo-accent);
+  font-size: 8px;
+}
+
+.boView-tasks .taskVariantAPill {
+  display: inline-flex;
+  align-items: center;
+  min-height: 24px;
+  border: 1px solid var(--bo-line);
+  border-radius: 999px;
+  background: var(--bo-panel-2);
+  color: var(--bo-muted);
+  font-size: 10px;
+  font-weight: 800;
+  padding: 4px 8px;
+  white-space: nowrap;
+}
+
+.boView-tasks .taskVariantAInvoice,
+.boView-tasks .taskVariantAManager {
+  color: var(--bo-text);
+  font-weight: 900;
+}
+
+.boView-tasks .taskCreated {
+  display: block;
+  margin-top: 7px;
+  color: var(--bo-muted);
+  font-size: 10px;
+  line-height: 1.35;
+  white-space: nowrap;
+}
+
+.boView-tasks .taskState {
+  align-self: start;
+  justify-self: end;
+}
+
+.boView-tasks .taskStatusBadge {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  min-height: 29px;
+  border: 1px solid var(--bo-line);
+  border-radius: 5px;
+  background: var(--bo-panel-2);
+  color: var(--bo-blue);
+  font-size: 10px;
+  font-weight: 900;
+  padding: 5px 8px;
+  white-space: nowrap;
+}
+
+.boView-tasks .taskStatus-new {
+  color: var(--bo-gold);
+}
+
+.boView-tasks .taskStatus-need_data,
+.boView-tasks .taskStatus-need-data {
+  color: #a38ad0;
+}
+
+/* Existing v064-J metadata is hidden once the approved A metadata exists. */
+.boView-tasks .taskCard:has(.taskVariantAMeta)
+  .taskCardInvoiceMeta {
+  display: none !important;
+}
+
+/* Return reason remains one compact line. */
+.boView-tasks .taskReturnNotice {
+  grid-column: 1 / -1;
+  margin-top: 1px;
+  border-top: 1px solid var(--bo-line);
+  background: transparent;
+}
+
+/* =========================================================
+   DESKTOP NAV — readable, not almost black on black
+   ========================================================= */
+
+@media (min-width: 721px) {
+  .bottomNav,
+  .boMobileNav {
+    left: 50% !important;
+    right: auto !important;
+    bottom: 14px !important;
+    transform: translateX(-50%);
+    width: min(720px, calc(100vw - 40px)) !important;
+    min-height: 56px;
+    display: grid !important;
+    grid-template-columns: repeat(3, 1fr);
+    gap: 4px;
+    padding: 5px !important;
+    border: 1px solid #3e4752 !important;
+    border-radius: 11px !important;
+    background: #1b2026 !important;
+    box-shadow: 0 12px 30px rgba(0,0,0,.32) !important;
+    opacity: 1 !important;
+  }
+
+  .bottomNav button,
+  .boMobileNav button,
+  .boMobileNav a {
+    min-height: 44px !important;
+    border: 0 !important;
+    border-radius: 7px !important;
+    background: transparent !important;
+    color: #aab4be !important;
+    opacity: 1 !important;
+    font-size: 13px !important;
+    font-weight: 850 !important;
+  }
+
+  .bottomNav button.active,
+  .boMobileNav button.active,
+  .boMobileNav a.active {
+    background: #303944 !important;
+    color: #ffffff !important;
+  }
+
+  .bottomNav button:disabled,
+  .boMobileNav button:disabled {
+    color: #6f7b86 !important;
+    opacity: 1 !important;
+  }
+}
+
+@media (max-width: 720px) {
+  .boView-tasks .taskCard {
+    grid-template-columns: minmax(0, 1fr) auto;
+    min-height: 0;
+    gap: 7px 8px;
+    padding: 12px 10px 11px 14px;
+  }
+
+  .boView-tasks .taskCardTitle > strong {
+    font-size: 15px;
+  }
+
+  .boView-tasks .taskVariantAMeta {
+    gap: 5px;
+  }
+
+  .boView-tasks .taskVariantADeal {
+    font-size: 14px;
+  }
+
+  .boView-tasks .taskVariantAPill {
+    max-width: 100%;
+    overflow: hidden;
+    text-overflow: ellipsis;
+  }
+}
+
+/* END_PART_V064_M_TASK_LIST_A */
+
+/* PART_V064_N1_V5B_POA_ETRN */
+
+.powerSubmitActions {
+  display: grid;
+  grid-template-columns:
+    minmax(0, 1fr)
+    minmax(0, 1fr);
+  gap: 8px;
+}
+
+.powerSubmitActions > button {
+  width: 100%;
+  min-height: 48px;
+}
+
+.powerEtrnAction {
+  display: grid;
+  gap: 8px;
+  margin-top: 10px;
+  padding-top: 10px;
+  border-top:
+    1px solid
+    var(--bo-line, #343437);
+}
+
+.powerEtrnLinked {
+  display: inline-flex;
+  align-items: center;
+  width: max-content;
+  max-width: 100%;
+  min-height: 28px;
+  border:
+    1px solid
+    color-mix(
+      in srgb,
+      var(--bo-green, #78a86b)
+        38%,
+      var(--bo-line, #343437)
+    );
+  border-radius: 5px;
+  background:
+    color-mix(
+      in srgb,
+      var(--bo-green, #78a86b)
+        10%,
+      transparent
+    );
+  color:
+    var(--bo-green, #78a86b);
+  font-size: 11px;
+  font-weight: 900;
+  padding: 5px 8px;
+}
+
+.powerEtrnForm {
+  display: grid;
+  gap: 10px;
+  border:
+    1px solid
+    var(--bo-line, #343437);
+  border-radius: 8px;
+  background:
+    var(--bo-panel, #1d2228);
+  padding: 12px;
+}
+
+.powerEtrnFormHead {
+  display: grid;
+  gap: 3px;
+}
+
+.powerEtrnFormHead strong {
+  font-size: 14px;
+  font-weight: 900;
+}
+
+.powerEtrnFormHead span {
+  color:
+    var(--bo-muted, #9aa3ad);
+  font-size: 11px;
+  line-height: 1.4;
+}
+
+.powerEtrnFormActions {
+  display: grid;
+  grid-template-columns:
+    minmax(0, .7fr)
+    minmax(0, 1.3fr);
+  gap: 8px;
+}
+
+@media (max-width: 720px) {
+  .powerSubmitActions,
+  .powerEtrnFormActions {
+    grid-template-columns: 1fr;
+  }
+}
+
+/* END_PART_V064_N1_V5B_POA_ETRN */
+
+/* PART_V064_N2_ETRN_FIELDS */
+
+.etrnAutoDocs,
+.etrnTaskDocs {
+  display: grid;
+  gap: 7px;
+}
+
+.etrnTaskDocs {
+  margin-bottom: 10px;
+  border: 1px solid var(--bo-line, #343437);
+  border-radius: 8px;
+  background: var(--bo-panel, #1d2228);
+  padding: 11px;
+}
+
+.etrnAutoDocRow {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr) auto;
+  gap: 10px;
+  align-items: center;
+  min-height: 52px;
+  border: 1px solid var(--bo-line, #343437);
+  border-radius: 7px;
+  background: var(--bo-panel-2, #242a31);
+  padding: 8px 10px;
+}
+
+.etrnAutoDocRow > div {
+  display: grid;
+  gap: 2px;
+  min-width: 0;
+}
+
+.etrnAutoDocRow span {
+  color: var(--bo-muted, #9aa3ad);
+  font-size: 10px;
+  font-weight: 750;
+}
+
+.etrnAutoDocRow strong {
+  overflow: hidden;
+  color: var(--bo-text, #f4f5f7);
+  font-size: 12px;
+  font-weight: 900;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.etrnAutoDocRow a {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  min-height: 34px;
+  border: 1px solid var(--bo-line, #343437);
+  border-radius: 6px;
+  background: var(--bo-panel, #1d2228);
+  color: var(--bo-text, #f4f5f7);
+  font-size: 11px;
+  font-weight: 850;
+  padding: 6px 9px;
+  text-decoration: none;
+}
+
+.etrnDocMissing {
+  color: var(--bo-red, #d27368);
+  font-size: 10px;
+  font-weight: 850;
+}
+
+/* END_PART_V064_N2_ETRN_FIELDS */
+
+
+/* PART_V064_O1_DEAL_WORKSPACE_C */
+
+.boView-deal.boShell {
+  max-width: 1180px !important;
+}
+
+.dealWorkspaceCPage {
+  gap: 12px;
+}
+
+.dealWorkspaceCLayout {
