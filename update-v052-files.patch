+}
+
+.requestPreviousIncoming > span {
+  color: #57534e;
+  font-size: 12px;
+  font-weight: 800;
+}
+
+.requestPreviousIncoming .versionRow {
+  margin: 0;
+  background: #fff;
+}
+
+.requestPreviousIncomingEmpty {
