+}
+
+html[data-theme='dark'] .requestPreviousIncoming .versionRow,
+html[data-theme='dark'] .requestPreviousIncomingEmpty {
+  background: #1d1d1f;
+}
+
+html[data-theme='dark'] .requestPreviousIncoming > span,
+html[data-theme='dark'] .fieldHint {
+  color: #a8a29e;
