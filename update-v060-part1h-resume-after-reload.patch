+
+const PENDING_KEY =
+  'msm.invoice-task-pending.v1';
+
+export type PendingInvoiceSubmission = {
+  taskId: string;
+  dealId: string;
+  clientName: string;
+  number: string;
+  amount?: number;
+  invoiceDate: string;
+  fileCount: number;
+  uploadedFileIds: Array<string | null>;
+};
+
+export function listPendingInvoiceSubmissions() {
+  try {
+    const raw =
+      window.localStorage.getItem(
+        PENDING_KEY,
+      );
+
+    if (!raw) {
+      return [] as PendingInvoiceSubmission[];
+    }
+
+    const parsed =
+      JSON.parse(raw) as unknown;
+
+    return Array.isArray(parsed)
+      ? parsed as PendingInvoiceSubmission[]
+      : [];
+  } catch {
+    return [];
+  }
+}
+
+export function savePendingInvoiceSubmission(
+  pending: PendingInvoiceSubmission,
+) {
+  const current =
+    listPendingInvoiceSubmissions();
+
+  const next = [
+    pending,
+    ...current.filter(
+      (item) =>
+        item.taskId !== pending.taskId
+    ),
+  ];
+
+  window.localStorage.setItem(
+    PENDING_KEY,
+    JSON.stringify(next),
+  );
+}
+
+export function markPendingInvoiceFileUploaded(
+  taskId: string,
+  index: number,
+  fileId: string,
+) {
+  const current =
+    listPendingInvoiceSubmissions();
+
+  const next =
+    current.map((item) => {
+      if (item.taskId !== taskId) {
+        return item;
+      }
+
+      const uploadedFileIds = [
+        ...item.uploadedFileIds,
+      ];
+
+      while (
+        uploadedFileIds.length <
+        item.fileCount
+      ) {
+        uploadedFileIds.push(null);
+      }
+
+      uploadedFileIds[index] =
+        fileId;
+
+      return {
+        ...item,
+        uploadedFileIds,
+      };
+    });
+
+  window.localStorage.setItem(
+    PENDING_KEY,
+    JSON.stringify(next),
+  );
+}
+
+export function clearPendingInvoiceSubmission(
+  taskId: string,
+) {
+  try {
+    const next =
+      listPendingInvoiceSubmissions()
+        .filter(
+          (item) =>
+            item.taskId !== taskId
+        );
+
+    if (next.length === 0) {
+      window.localStorage.removeItem(
+        PENDING_KEY,
+      );
+      return;
+    }
+
+    window.localStorage.setItem(
+      PENDING_KEY,
+      JSON.stringify(next),
+    );
+  } catch {
+    // Черновик счёта остаётся отдельной страховкой.
+  }
+}
