+const pendingInvoiceResumeLocks =
+  new Set<string>();
+
+async function resumePendingInvoiceSubmission(
+  pending: PendingInvoiceSubmission,
+  actorId: string,
+) {
+  if (
+    pendingInvoiceResumeLocks.has(
+      pending.taskId
+    )
+  ) {
+    return;
+  }
+
+  pendingInvoiceResumeLocks.add(
+    pending.taskId
+  );
+
+  try {
+    const files =
+      await loadInvoiceTaskDraftFiles(
+        pending.taskId,
+      );
+
+    const uploadedFileIds = [
+      ...pending.uploadedFileIds,
+    ];
+
+    while (
+      uploadedFileIds.length <
+      pending.fileCount
+    ) {
+      uploadedFileIds.push(null);
+    }
+
+    startBackgroundUploadJob({
+      taskId:
+        pending.taskId,
+
+      dealId:
+        pending.dealId,
+
+      title:
+        'Возобновляем отправку счёта',
+
+      successTitle:
+        'Счёт отправлен',
+
+      subtitle:
+        pending.clientName,
+
+      files,
+
+      run:
+        async ({
+          upload,
+          setProgress,
+        }) => {
+          for (
+            let index = 0;
+            index < pending.fileCount;
+            index++
+          ) {
+            if (
+              uploadedFileIds[index]
+            ) {
+              setProgress(
+                Math.round(
+                  (
+                    (index + 1) /
+                    Math.max(
+                      pending.fileCount,
+                      1
+                    )
+                  ) * 90
+                )
+              );
+              continue;
+            }
+
+            const file =
+              files[index];
+
+            if (!file) {
+              throw new Error(
+                'Не удалось восстановить один из файлов счёта. Откройте задачу и прикрепите файл повторно.'
+              );
+            }
+
+            const uploaded =
+              await upload(
+                pending.dealId,
+                file,
+                'CLIENT_INVOICE_ATTACHMENT',
+                index,
+                pending.fileCount,
+              );
+
+            uploadedFileIds[index] =
+              uploaded.id;
+
+            markPendingInvoiceFileUploaded(
+              pending.taskId,
+              index,
+              uploaded.id,
+            );
+          }
+
+          setProgress(94);
+
+          await createInvoice(
+            pending.dealId,
+            {
+              number:
+                pending.number,
+
+              amount:
+                pending.amount,
+
+              invoiceDate:
+                pending.invoiceDate,
+
+              fileId:
+                uploadedFileIds[0] ||
+                undefined,
+
+              actorId,
+            },
+          );
+
+          clearPendingInvoiceSubmission(
+            pending.taskId,
+          );
+
+          await clearInvoiceTaskDraft(
+            pending.taskId,
+          ).catch(() => undefined);
+
+          setProgress(99);
+        },
+    });
+  } catch (error) {
+    console.warn(
+      'Не удалось восстановить незавершённую отправку счёта',
+      error,
+    );
+  } finally {
+    pendingInvoiceResumeLocks.delete(
+      pending.taskId
+    );
+  }
+}
+
+function resumePendingInvoiceSubmissions(
+  actorId: string,
+) {
+  const pending =
+    listPendingInvoiceSubmissions();
+
+  for (const item of pending) {
+    void resumePendingInvoiceSubmission(
+      item,
+      actorId,
+    );
+  }
+}
