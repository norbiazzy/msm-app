+/* MSM invoice request workflow v0.5.0 */
+
+.invoiceRequestManagerBox {
+  display: grid;
+  gap: 12px;
+  padding: 14px;
+  border: 1px solid #e7e5e4;
+  border-radius: 18px;
+  background: #fff;
+  animation: msmFadeUp 220ms cubic-bezier(.2,.8,.25,1) both;
+}
+
+.invoiceRequestStateRow,
+.invoiceRequestReturnedHead {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 12px;
+}
+
+.invoiceRequestStateRow > div,
+.invoiceRequestReturnedHead > div {
+  min-width: 0;
+}
+
+.invoiceRequestStateRow strong,
+.invoiceRequestStateRow span,
+.invoiceRequestReturnedHead strong,
+.invoiceRequestReturnedHead span {
+  display: block;
+}
+
+.invoiceRequestStateRow span,
+.invoiceRequestReturnedHead span {
+  margin-top: 3px;
+  color: #78716c;
+  font-size: 11px;
+  line-height: 1.4;
+}
+
+.invoiceRequestReturnedHead > b {
+  flex: 0 0 auto;
+  padding: 5px 8px;
+  border-radius: 999px;
+  background: #ede9fe;
+  color: #6d28d9;
+  font-size: 11px;
+}
+
+.invoiceReturnReason {
+  display: grid;
+  gap: 3px;
+  padding: 11px 12px;
+  border-radius: 13px;
+  background: #faf5ff;
+  border: 1px solid #e9d5ff;
+}
+
+.invoiceReturnReason > span {
+  color: #7c3aed;
+  font-size: 10px;
+  font-weight: 800;
+  text-transform: uppercase;
+  letter-spacing: .04em;
+}
+
+.invoiceReturnReason > strong {
+  font-size: 13px;
+}
+
+.invoiceReturnReason > p {
+  margin: 3px 0 0;
+  color: #57534e;
+  font-size: 12px;
+  white-space: pre-wrap;
+}
+
+.invoiceRequestRepairForm {
+  display: grid;
+  gap: 11px;
+  padding-top: 2px;
+}
+
+.selectedRequestFile {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 10px;
+  padding: 9px 10px;
+  border-radius: 12px;
+  background: #fafaf9;
+}
+
+.selectedRequestFile b {
+  min-width: 0;
+  overflow-wrap: anywhere;
+  font-size: 12px;
+}
+
+.invoiceRequestWithdrawCompact {
+  width: auto;
+  flex: 0 0 auto;
+  padding: 10px 12px;
+}
+
+.invoiceTaskStartActions {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr) minmax(0, 1.35fr);
+  gap: 9px;
+}
+
+.invoiceTaskInWorkBox {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 12px;
+}
+
+.invoiceTaskInWorkBox > div {
+  min-width: 0;
+}
+
+.invoiceTaskInWorkBox p {
+  margin-top: 4px;
+}
+
+.invoiceReturnModal {
+  max-height: min(720px, calc(100vh - 32px));
+  overflow-y: auto;
+}
+
+.invoiceReturnReasons {
+  display: grid;
+  gap: 7px;
+}
+
+.invoiceReturnReason {
+  width: 100%;
+}
+
+button.invoiceReturnReason {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  padding: 11px 12px;
+  text-align: left;
+  border: 1px solid #e7e5e4;
+  border-radius: 12px;
+  background: #fafaf9;
+  color: #171717;
+  transition:
+    border-color 160ms ease,
+    background-color 160ms ease,
+    transform 120ms ease;
+}
+
+button.invoiceReturnReason:active {
+  transform: scale(.992);
+}
+
+button.invoiceReturnReason.selected {
+  border-color: #a78bfa;
+  background: #f5f3ff;
+}
+
+.invoiceReturnRadio {
+  width: 17px;
+  height: 17px;
+  flex: 0 0 17px;
+  border: 2px solid #a8a29e;
+  border-radius: 50%;
+  box-shadow: inset 0 0 0 3px #fafaf9;
+}
+
+button.invoiceReturnReason.selected .invoiceReturnRadio {
+  border-color: #7c3aed;
+  background: #7c3aed;
+  box-shadow: inset 0 0 0 3px #f5f3ff;
+}
+
+html[data-theme='dark'] .invoiceRequestManagerBox {
+  background: #1d1d1f;
+  border-color: #343437;
+}
+
+html[data-theme='dark'] .invoiceRequestStateRow span,
+html[data-theme='dark'] .invoiceRequestReturnedHead span {
+  color: #a8a29e;
+}
+
+html[data-theme='dark'] .invoiceReturnReason {
+  background: #251d2d;
+  border-color: #4c1d5f;
+}
+
+html[data-theme='dark'] .invoiceReturnReason > p {
+  color: #d6d3d1;
+}
+
+html[data-theme='dark'] .selectedRequestFile,
+html[data-theme='dark'] button.invoiceReturnReason {
+  background: #242426;
+  border-color: #3f3f42;
+  color: #f5f5f4;
+}
+
+html[data-theme='dark'] button.invoiceReturnReason.selected {
+  background: #2e2540;
+  border-color: #7c3aed;
+}
+
+html[data-theme='dark'] .invoiceReturnRadio {
+  box-shadow: inset 0 0 0 3px #242426;
+}
+
+html[data-theme='dark'] button.invoiceReturnReason.selected .invoiceReturnRadio {
+  box-shadow: inset 0 0 0 3px #2e2540;
+}
+
+/* Mobile thumb-zone: extra scroll room lets the last card/button
+   move into a comfortable one-hand reach area above the bottom nav. */
+@media (max-width: 820px) {
