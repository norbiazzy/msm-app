+
+/* MSM deal layout v0.5.5 */
+.dealOverview { display:grid; gap:14px; padding:16px; border:1px solid #e7e5e4; border-radius:20px; background:#fff; }
+.dealOverviewHead { display:flex; align-items:flex-start; justify-content:space-between; gap:16px; }
+.dealOverviewHead h2 { margin:5px 0 0; font-size:26px; }
+.dealOverviewMeta { display:flex; gap:9px; flex-wrap:wrap; color:#a8a29e; font-size:11px; }
+.dealOverviewInvoiceStatus { text-align:right; }
+.dealOverviewInvoiceStatus span,.dealOverviewInvoiceStatus b { display:block; }
+.dealOverviewInvoiceStatus span { color:#a8a29e; font-size:10px; }
+.dealOverviewInvoiceStatus b { margin-top:3px; font-size:12px; }
+.dealOverviewGrid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:8px; }
+.dealMetric { min-width:0; min-height:78px; display:flex; flex-direction:column; justify-content:center; align-items:flex-start; gap:4px; padding:11px 12px; border:1px solid #eceae7; border-radius:14px; background:#fafaf9; text-align:left; color:#171717; }
+.dealMetric span { color:#78716c; font-size:10px; }
+.dealMetric b { max-width:100%; font-size:14px; overflow-wrap:anywhere; }
+.dealMetric em { color:#a8a29e; font-size:9px; font-style:normal; }
+.dealMetricButton { cursor:pointer; transition:transform .16s ease, background .16s ease, border-color .16s ease; }
+.dealMetricButton:not(:disabled):hover { background:#f5f5f4; border-color:#d6d3d1; }
+.dealMetricButton:not(:disabled):active { transform:scale(.985); }
+.dealMetricButton:disabled { cursor:default; opacity:1; }
+.dealMetricMuted { background:#fff; }
+.dealQuickEditor { display:grid; gap:10px; padding:12px; border:1px solid #d6d3d1; border-radius:14px; background:#fafaf9; animation:msmFadeUp 160ms ease-out both; }
+.dealQuickActions { display:grid; grid-template-columns:auto 1fr 36px; gap:8px; }
+.dealQuickClose { border:0; border-radius:10px; background:#e7e5e4; font-size:20px; }
+.dealQuickMessage { color:#57534e; font-size:12px; line-height:1.45; }
+.dealInfoView { display:grid; grid-template-columns:1fr 1fr; gap:8px; }
+.dealInfoRow { min-width:0; padding:10px 11px; border-radius:12px; background:#fafaf9; }
+.dealInfoRow span,.dealInfoRow b { display:block; }
+.dealInfoRow span { color:#78716c; font-size:10px; }
+.dealInfoRow b { margin-top:3px; overflow-wrap:anywhere; }
+.dealInfoCompany { order:1; }
+.dealInfoView > .dealInfoRow:nth-of-type(2) { order:2; }
+.dealInfoView > .dealInfoRow:nth-of-type(3) { order:3; }
+.dealInfoAddress { order:4; grid-column:1/-1; }
+.dealInfoComment { order:5; grid-column:1/-1; }
+.dealInfoEditButton { min-width:40px; font-size:16px; letter-spacing:1px; }
+.invoiceDecisionBar { display:grid; grid-template-columns:1fr 1fr; gap:9px; }
+.invoiceDecisionBarSingle { grid-template-columns:1fr; }
+.purchaseExistingInvoiceField small { color:#78716c; font-size:10px; font-weight:500; line-height:1.35; }
+html[data-theme='dark'] .dealOverview,html[data-theme='dark'] .dealQuickEditor { background:#1d1d1f; border-color:#343437; }
+html[data-theme='dark'] .dealMetric,html[data-theme='dark'] .dealInfoRow { background:#242426; border-color:#343437; color:#f5f5f4; }
+html[data-theme='dark'] .dealMetricMuted { background:#1d1d1f; }
+html[data-theme='dark'] .dealQuickClose { background:#303033; color:#f5f5f4; }
+@media (max-width:520px){ .dealOverviewGrid{grid-template-columns:1fr 1fr;} .dealOverviewHead{align-items:flex-start;} .dealOverviewHead h2{font-size:23px;} .dealOverviewInvoiceStatus{max-width:42%;} .dealInfoView{grid-template-columns:1fr 1fr;} .dealQuickActions{grid-template-columns:1fr 1fr 36px;} }
