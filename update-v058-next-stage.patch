+export function PowerOfAttorneyTask({
+  task,
+  user,
+  onBack,
+}: {
+  task: Task;
+  user: CurrentUser;
+  onBack: () => void;
+}) {
+
+  const [status, setStatus] =
+    useState(task.status);
+
+  const [files, setFiles] =
+    useState<File[]>([]);
+
+  const [saving, setSaving] =
+    useState(false);
+
+  const [error, setError] =
+    useState('');
+
+  const payload =
+    task.payload || {};
+
+  const requestKey =
+    String(
+      payload.requestKey || ''
+    );
+
+  const sourceFiles =
+    requestKey
+      ? (task.deal.files || [])
+          .filter(
+            (file) =>
+              file.category ===
+              'POWER_OF_ATTORNEY_SOURCE_' +
+              requestKey
+          )
+      : [];
+
+
+  async function take() {
+    setSaving(true);
+    setError('');
+
+    try {
+      await updateTaskStatus(
+        task.id,
+        'IN_PROGRESS',
+        user.id,
+      );
+      setStatus('IN_PROGRESS');
+    } catch (e) {
+      setError(
+        e instanceof Error
+          ? e.message
+          : String(e)
+      );
+    } finally {
+      setSaving(false);
+    }
+  }
+
+
+  function finish() {
+    setError('');
+
+    if (files.length === 0) {
+      setError(
+        'Прикрепите готовую доверенность.'
+      );
+      return;
+    }
+
+    const filesToUpload =
+      [...files];
+
+    setFiles([]);
+
+    startBackgroundUploadJob({
+      taskId: task.id,
+      dealId: task.deal.id,
+      title:
+        'Загружаем доверенность',
+      successTitle:
+        'Доверенность готова',
+      subtitle:
+        String(
+          payload.supplierName ||
+          task.deal.clientName
+        ),
+      files: filesToUpload,
+
+      run: async ({
+        upload,
+        setProgress,
+      }) => {
+        for (
+          let index = 0;
+          index < filesToUpload.length;
+          index++
+        ) {
+          await upload(
+            task.deal.id,
+            filesToUpload[index],
+            'POWER_OF_ATTORNEY_RESULT_' +
+            task.id,
+            index,
+            filesToUpload.length,
+          );
+        }
+
+        setProgress(95);
+        await completePowerOfAttorneyTask(
+          task.id,
+          user.id,
+        );
+        setProgress(99);
+      },
+    });
+
+    onBack();
+  }
+
+
+  return (
+    <section className="content form">
+
+      <button
+        className="backLink"
+        onClick={onBack}
+      >
+        ← К задачам
+      </button>
+
+
+      <div className="detailHero">
+        <div className="eyebrow">
+          ЗК-{task.deal.internalNumber}
+        </div>
+
+        <h2>Сделать доверенность</h2>
+
+        <p>
+          {String(
+            payload.supplierName ||
+            task.deal.clientName
+          )}
+        </p>
+
+        <div className="statusPill">
+          {taskStatusLabel(status)}
+        </div>
+
+        {task.urgent && (
+          <b className="urgent">
+            СРОЧНО
+          </b>
+        )}
+      </div>
+
+
+      <div className="powerTaskGrid">
+        <div>
+          <span>От организации</span>
+          <b>
+            {sellerLabels[
+              String(
+                payload.organization ||
+                task.deal.sellerType
+              ) as SellerType
+            ] ||
+            String(
+              payload.organization ||
+              task.deal.sellerType
+            )}
+          </b>
+        </div>
+
+        <div>
+          <span>На кого</span>
+          <b>
+            {String(
+              payload.recipientName || '—'
+            )}
+          </b>
+        </div>
+
+        <div>
+          <span>Входящий счёт</span>
+          <b>
+            {String(
+              payload.invoiceNumber || '—'
+            )}
+          </b>
+        </div>
+
+        <div>
+          <span>Дата</span>
+          <b>
+            {payload.requestDate
+              ? new Date(
+                  String(
+                    payload.requestDate
+                  ) + 'T12:00:00'
+                ).toLocaleDateString(
+                  'ru-RU'
+                )
+              : '—'}
+          </b>
+        </div>
+      </div>
+
+
+      <div className="infoBox">
+        <strong>Что получаем</strong>
+        <p>
+          {String(
+            payload.goodsDescription || '—'
+          )}
+        </p>
+      </div>
+
+
+      {task.description && (
+        <div className="infoBox">
+          <strong>Комментарий менеджера</strong>
+          <p>{task.description}</p>
+        </div>
+      )}
+
+
+      {sourceFiles.length > 0 && (
+        <div className="infoBox">
+          <strong>Документы к запросу</strong>
+          <div className="versionList">
+            {sourceFiles.map(
+              (file) => (
+              <div
+                key={file.id}
+                className="versionRow"
+              >
+                <div>
+                  <b>{file.originalName}</b>
+                </div>
+                <a
+                  href={dealFileUrl(
+                    file.id
+                  )}
+                  target="_blank"
+                  rel="noreferrer"
+                >
+                  Открыть
+                </a>
+              </div>
+            ))}
+          </div>
+        </div>
+      )}
+
+
+      {status === 'NEW' && (
+        <button
+          type="button"
+          className="primary wide"
+          disabled={saving}
+          onClick={take}
+        >
+          {saving ? 'Сохраняем…' : 'В работу'}
+        </button>
+      )}
+
+
+      {status === 'IN_PROGRESS' && (
+        <>
+          <label className="field">
+            <span>Готовая доверенность</span>
+            <MultiFilePicker
+              files={files}
+              onChange={setFiles}
+              title="+ Прикрепить доверенность"
+            />
+          </label>
+
+          <button
+            type="button"
+            className="primary wide"
+            disabled={saving}
+            onClick={finish}
+          >
+            Доверенность готова
+          </button>
+        </>
+      )}
+
+
+      {error && (
+        <div className="error">{error}</div>
+      )}
+
+    </section>
+  );
+}
