+import {
+  useMemo,
+  useState,
+} from 'react';
+
+import {
+  completePowerOfAttorneyTask,
+  createPowerOfAttorneyTask,
+  dealFileUrl,
+  updateTaskStatus,
+  type Task,
+} from './api';
+
+import {
+  MultiFilePicker,
+} from './MultiFilePicker';
+
+import {
+  startBackgroundUploadJob,
+} from './backgroundUploads';
+
+import type {
+  CurrentUser,
+  Deal,
+  SellerType,
+} from './types';
+
+
+const sellerLabels:
+  Record<SellerType, string> = {
+    ST: 'СТ',
+    MSM: 'МСМ',
+    IP: 'ИП',
+  };
+
+
+function todayLocalDate() {
+  const now = new Date();
+  const local = new Date(
+    now.getTime() -
+    now.getTimezoneOffset() * 60000
+  );
+
+  return local
+    .toISOString()
+    .slice(0, 10);
+}
+
+
+function taskStatusLabel(
+  status: string,
+) {
+  return ({
+    NEW: 'Новая',
+    IN_PROGRESS: 'В работе',
+    NEED_DATA: 'Нужны данные',
+    DONE: 'Готова',
+    CANCELLED: 'Отменена',
+  } as Record<string, string>)[status] || status;
+}
+
+
+export function PowerOfAttorneyBlock({
+  deal,
+  user,
+  onChanged,
+}: {
+  deal: Deal;
+  user: CurrentUser;
+  onChanged:
+    () => void | Promise<void>;
+}) {
+
+  const [open, setOpen] =
+    useState(false);
+
+  const [supplierName, setSupplierName] =
+    useState('');
+
+  const [organization, setOrganization] =
+    useState<SellerType>(deal.sellerType);
+
+  const [recipientName, setRecipientName] =
+    useState('');
+
+  const [invoiceNumber, setInvoiceNumber] =
+    useState('');
+
+  const [requestDate, setRequestDate] =
+    useState(todayLocalDate());
+
+  const [goodsDescription, setGoodsDescription] =
+    useState('');
+
+  const [comment, setComment] =
+    useState('');
+
+  const [files, setFiles] =
+    useState<File[]>([]);
+
+  const [urgent, setUrgent] =
+    useState(false);
+
+  const [saving, setSaving] =
+    useState(false);
+
+  const [error, setError] =
+    useState('');
+
+
+  const requests = useMemo(
+    () =>
+      (deal.tasks || [])
+        .filter(
+          (task) =>
+            task.type ===
+            'POWER_OF_ATTORNEY'
+        ),
+    [deal.tasks],
+  );
+
+
+  const supplierOptions = useMemo(
+    () =>
+      Array.from(
+        new Set(
+          (deal.supplierPurchases || [])
+            .map(
+              (purchase) =>
+                purchase.supplierName
+            )
+            .filter(Boolean)
+        )
+      ),
+    [deal.supplierPurchases],
+  );
+
+
+  function resetForm() {
+    setSupplierName('');
+    setOrganization(deal.sellerType);
+    setRecipientName('');
+    setInvoiceNumber('');
+    setRequestDate(todayLocalDate());
+    setGoodsDescription('');
+    setComment('');
+    setFiles([]);
+    setUrgent(false);
+    setOpen(false);
+  }
+
+
+  async function createTask(
+    requestKey: string,
+  ) {
+    await createPowerOfAttorneyTask({
+      dealId: deal.id,
+      actorId: user.id,
+      urgent,
+      requestKey,
+      supplierName:
+        supplierName.trim(),
+      organization,
+      recipientName:
+        recipientName.trim(),
+      invoiceNumber:
+        invoiceNumber.trim() ||
+        undefined,
+      requestDate:
+        requestDate || undefined,
+      goodsDescription:
+        goodsDescription.trim(),
+      comment:
+        comment.trim() ||
+        undefined,
+    });
+  }
+
+
+  async function submit() {
+    setError('');
+
+    if (!supplierName.trim()) {
+      setError(
+        'Укажите поставщика / завод.'
+      );
+      return;
+    }
+
+    if (!recipientName.trim()) {
+      setError(
+        'Укажите, на кого нужна доверенность.'
+      );
+      return;
+    }
+
+    if (!goodsDescription.trim()) {
+      setError(
+        'Укажите, что получаем.'
+      );
+      return;
+    }
+
+
+    const requestKey =
+      'poa-' +
+      Date.now() +
+      '-' +
+      Math.random()
+        .toString(36)
+        .slice(2, 8);
+
+    const filesToUpload =
+      [...files];
+
+
+    if (filesToUpload.length > 0) {
+      startBackgroundUploadJob({
+        dealId: deal.id,
+        title:
+          'Отправляем запрос на доверенность',
+        successTitle:
+          'Запрос на доверенность отправлен',
+        subtitle:
+          supplierName.trim(),
+        files: filesToUpload,
+
+        run: async ({
+          upload,
+          setProgress,
